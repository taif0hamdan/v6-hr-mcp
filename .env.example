# =============================================================================
# Smart MCP Server - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Priority: .env values take precedence over config.yaml
# Defaults in this file are chosen for AIR-GAPPED / offline operation:
#   - the LLM endpoint defaults to a local address, never api.openai.com
#   - remote OpenAPI spec fetching is disabled by default
#   - nothing that could reveal table/column names or SQL is exposed by default
# =============================================================================

# -----------------------------------------------------------------------------
# Server Mode
# -----------------------------------------------------------------------------
# Options: "database" or "api"
MODE=database

# Transport: "stdio" (default, for MCP clients that spawn the process) or
# "http" (binds 0.0.0.0:${MCP_PORT})
MCP_TRANSPORT=stdio
MCP_PORT=8000

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Preferred name for the OpenAI-compatible base URL. Point this at your local
# LLM server (Ollama, OpenWebUI, vLLM, llama.cpp server, ...). Do NOT set this
# to https://api.openai.com/v1 in an air-gapped environment.
LLM_BASE_URL=http://localhost:8080/v1

# Legacy name, still read if LLM_BASE_URL is unset (kept for backward compatibility).
# LLM_API_BASE=http://localhost:8080/v1

# API key - OPTIONAL. Many local OpenAI-compatible servers ignore this.
# LLM_API_KEY=your-api-key-here

# Model to use
LLM_MODEL=llama3.1:latest

# Temperature (0.0 - 1.0)
LLM_TEMPERATURE=0.0

# Max tokens for response
LLM_MAX_TOKENS=500

# Request timeout in seconds. Raise this for slow/CPU-partial local models
# where the first call can take a couple of minutes.
LLM_TIMEOUT_SECONDS=60

# Ollama-specific: context window size, passed through via extra_body.
# Leave unset to use the server/model's own default.
# LLM_NUM_CTX=16384

# Ollama-specific: suppress a reasoning model's <think> block (e.g. Qwen3)
# so responses are the direct answer, not a visible reasoning trace. Sent
# both as the OpenAI-compat "think": false field and as a literal
# "/no_think" appended to the prompt, for whichever mechanism the server/
# model actually honors.
LLM_DISABLE_THINKING=false

# -----------------------------------------------------------------------------
# Database Configuration (when MODE=database)
# -----------------------------------------------------------------------------
# Database connection string. Overrides config.yaml's database.connection_string.
# Examples:
#   SQLite:     sqlite:///path/to/database.db   (opened read-only automatically)
#   PostgreSQL: postgresql://readonly_user:password@localhost:5432/dbname
#   MySQL:      mysql+pymysql://readonly_user:password@localhost:3306/dbname
#   Oracle:     oracle+oracledb://readonly_user:password@host:1521/service_name
# Docker default (see docker-compose.yml): sqlite:////data/db.sqlite
DATABASE_URL=sqlite:///example.db

# Maximum rows to return per query
DATABASE_MAX_ROWS=1000

# Best-effort statement timeout in seconds for query_database
DATABASE_STATEMENT_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Database documentation ("concepts") directory
# -----------------------------------------------------------------------------
# Directory of *.yaml/*.yml concept docs loaded by search_concepts / concept://.
# Docker default: /app/database_docs
# DOCS_DIR=./database_docs

# -----------------------------------------------------------------------------
# API Configuration (when MODE=api)
# -----------------------------------------------------------------------------
# URL or local path to OpenAPI/Swagger spec (JSON or YAML).
# For air-gapped operation, use a LOCAL FILE PATH here.
API_SPEC_URL=./openapi/local-spec.yaml

# Must be "true" to allow API_SPEC_URL to be a remote http(s) URL.
# Leave "false" (default) for air-gapped deployments.
API_ALLOW_REMOTE_SPEC=false

# Allow non-GET requests (POST, PUT, DELETE)
# WARNING: Setting this to true allows the LLM to modify data!
API_UNSAFE_MODE=false

# -----------------------------------------------------------------------------
# Safety Configuration
# -----------------------------------------------------------------------------
# Restrict to read-only operations (database mode)
SAFETY_READ_ONLY=true

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# These only affect SUCCESSFUL responses from schema://database and
# query_database. Error messages never expose these regardless of these
# settings - that masking is unconditional.

# Hide database details from success responses (recommended for production)
SECURITY_HIDE_DATABASE_DETAILS=true

# Expose generated SQL in success responses
SECURITY_EXPOSE_SQL=false

# Expose column names in success responses
SECURITY_EXPOSE_COLUMN_NAMES=false

# Expose table names in success responses
SECURITY_EXPOSE_TABLE_NAMES=false

# Log detailed errors server-side (stderr only - never sent to the model/client)
SECURITY_LOG_DETAILED_ERRORS=true

# -----------------------------------------------------------------------------
# HR Backend (hr_backend/) - separate REST app: LDAP auth, committees,
# evaluation sessions, evaluations, results, unit reports. Independent of
# everything above; see docker-compose.yml's hr-backend service.
# -----------------------------------------------------------------------------

# REQUIRED, no safe default - the app refuses to start without it. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HR_SESSION_SECRET=

# "development" or "production". Refuses to start if DEV_LOGIN_BYPASS=true
# AND this is "production" - a login bypass must never ship live.
HR_BACKEND_ENV=development

# Local app database (users, committees, sessions, evaluations, results,
# HR cache snapshots) - NOT the HR Oracle database, and not the MCP tool's
# query target. Docker default: sqlite:////hr_backend_data/hr_backend.db
# HR_BACKEND_DATABASE_URL=sqlite:///hr_backend.db

# HR provider (verified contract: V4 - oracleapi). Server-side only -
# never call this directly from a browser.
# HR_API_BASE_URL=http://192.168.27.31:9009
# HR_API_SINGLE_TIMEOUT_SECONDS=10
# HR_API_BULK_TIMEOUT_SECONDS=120

# LDAP - unset by default (login reports "not configured" until set).
# LDAP_HOST=
# LDAP_PORT=389
# LDAP_USE_SSL=false
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=
# LDAP_EMPLOYEE_ATTR=employeeID
# LDAP_USERNAME_ATTR=sAMAccountName
# LDAP_EMAIL_ATTR=mail

# Development-only local-login bypass (no real LDAP needed) - refused if
# HR_BACKEND_ENV=production. Never enable this in a shipped deployment.
# DEV_LOGIN_BYPASS=false

# Whether a first-time LDAP login with no matching local account creates
# one automatically. false means an administrator must provision accounts first.
# AUTO_PROVISION_USERS=true

# HR cache TTLs (seconds) - see hr_backend/hr_cache.py for the policy these implement.
# CACHE_PROFILE_TTL_SECONDS=900
# CACHE_DIVISIONS_TTL_SECONDS=3600
# CACHE_SEARCH_TTL_SECONDS=60
# CACHE_ROSTER_FRESH_SECONDS=900
# CACHE_ROSTER_MAX_SERVED_AGE_SECONDS=86400
# CACHE_BACKGROUND_POLL_SECONDS=60
# CACHE_BACKGROUND_REFRESH_ENABLED=true

# No real active/inactive status field exists in the currently-connected
# HR data (verified empty/absent - see eligibility.py) - leave unset until
# one is identified. Setting HR_EMPLOYEE_STATUS_FIELD without also setting
# HR_ACTIVE_STATUS_VALUES will exclude every employee (missing status is
# "not active" once a field is configured).
# HR_EMPLOYEE_STATUS_FIELD=
# HR_ACTIVE_STATUS_VALUES=

# Port the hr-backend service is published on (docker-compose.yml).
# HR_BACKEND_PORT=8090
